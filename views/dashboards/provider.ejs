<%- include("../partials/header", { pageTitle: "Service provider dashboard" }) %>
<section class="container dashboard-page"><div class="dashboard-welcome"><div><div class="eyebrow muted-eyebrow">YOUR PROFESSIONAL SPACE</div><h1>Let's make it a <span>good workday.</span></h1><p>Hi <%= currentUser.name.split(" ")[0] %>, manage your incoming service requests here.</p></div><a class="btn btn-primary" href="/profile">Edit my profile <span>↗</span></a></div>
<div class="stats-grid"><article class="stat-card"><span class="stat-icon purple">▤</span><div><small>Total requests</small><strong><%= bookings.length %></strong></div></article><article class="stat-card"><span class="stat-icon green">◷</span><div><small>Pending requests</small><strong><%= bookings.filter(b => b.status === "pending").length %></strong></div></article><article class="stat-card"><span class="stat-icon orange">✓</span><div><small>Accepted jobs</small><strong><%= bookings.filter(b => b.status === "accepted").length %></strong></div></article></div>
<div class="dashboard-content"><div class="dashboard-section-heading"><div><h2>Incoming service requests</h2><p>Review each request and update its status.</p></div><a class="text-link" href="/profile">Update availability →</a></div>
<% if (bookings.length) { %><div class="booking-list"><% bookings.forEach(b => { %><article class="booking-row provider-booking"><div class="booking-date"><strong><%= new Date(b.serviceDate).toLocaleDateString("en-IN", { day:"2-digit" }) %></strong><span><%= new Date(b.serviceDate).toLocaleDateString("en-IN", { month:"short" }) %></span></div><div class="booking-info"><h3><%= b.consumer ? b.consumer.name : "Customer" %></h3><p>⌖ <%= b.address %></p><small><%= new Date(b.serviceDate).toLocaleString("en-IN", { dateStyle:"medium", timeStyle:"short" }) %><%= b.consumer && b.consumer.phone ? " · " + b.consumer.phone : "" %></small><% if (b.notes) { %><p class="booking-notes">“<%= b.notes %>”</p><% } %></div><div class="booking-actions"><span class="status status-<%= b.status %>"><%= b.status %></span><% if (b.status === "pending") { %><form action="/bookings/<%= b._id %>/status" method="POST"><input type="hidden" name="status" value="accepted"><button class="btn btn-primary btn-small" type="submit">Accept</button></form><form action="/bookings/<%= b._id %>/status" method="POST"><input type="hidden" name="status" value="cancelled"><button class="btn btn-outline btn-small" type="submit">Decline</button></form><% } else if (b.status === "accepted") { %><form action="/bookings/<%= b._id %>/status" method="POST"><input type="hidden" name="status" value="completed"><button class="btn btn-primary btn-small" type="submit">Mark complete</button></form><% } %></div></article><% }) %></div><% } else { %><div class="empty-state compact-empty"><div class="empty-icon">✦</div><h3>Your next opportunity is on its way</h3><p>Complete your professional profile and switch on availability so customers can discover you.</p><a class="btn btn-primary" href="/profile">Complete my profile →</a></div><% } %>
</div></section>
<%- include("../partials/footer") %>
