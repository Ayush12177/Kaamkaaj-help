<%- include("../partials/header", { pageTitle: "Consumer dashboard" }) %>
<section class="container dashboard-page"><div class="dashboard-welcome"><div><div class="eyebrow muted-eyebrow">YOUR KAAMKAAJ SPACE</div><h1>Good to see you, <span><%= currentUser.name.split(" ")[0] %>.</span></h1><p>Find help, manage requests, and keep your day moving.</p></div><a class="btn btn-primary" href="/providers">Find a service <span>→</span></a></div>
<div class="stats-grid"><article class="stat-card"><span class="stat-icon purple">▤</span><div><small>Total requests</small><strong><%= bookings.length %></strong></div></article><article class="stat-card"><span class="stat-icon green">◷</span><div><small>Pending requests</small><strong><%= bookings.filter(b => b.status === "pending").length %></strong></div></article><article class="stat-card"><span class="stat-icon orange">✦</span><div><small>Available pros</small><strong><%= providerCount %></strong></div></article></div>
<div class="dashboard-content"><div class="dashboard-section-heading"><div><h2>Your booking requests</h2><p>Updates from your service professionals appear here.</p></div><a class="text-link" href="/providers">Find more help →</a></div>
<% if (bookings.length) { %><div class="booking-list"><% bookings.forEach(b => { %><article class="booking-row"><div class="booking-date"><strong><%= new Date(b.serviceDate).toLocaleDateString("en-IN", { day:"2-digit" }) %></strong><span><%= new Date(b.serviceDate).toLocaleDateString("en-IN", { month:"short" }) %></span></div><div class="booking-info"><h3><%= b.provider ? b.provider.name : "Provider account unavailable" %></h3><p><%= b.provider ? (b.provider.profession || "Service professional") : "Provider" %> · <%= b.address %></p><small>Requested for <%= new Date(b.serviceDate).toLocaleString("en-IN", { dateStyle:"medium", timeStyle:"short" }) %></small></div><span class="status status-<%= b.status %>"><%= b.status %></span></article><% }) %></div><% } else { %><div class="empty-state compact-empty"><div class="empty-icon">▤</div><h3>Your next booking starts here</h3><p>You haven't sent any service requests yet. Explore local professionals to get started.</p><a class="btn btn-primary" href="/providers">Browse professionals →</a></div><% } %>
</div></section>
<%- include("../partials/footer") %>
