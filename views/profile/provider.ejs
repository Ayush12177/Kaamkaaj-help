<%- include("../partials/header", { pageTitle: "Professional profile" }) %>
<section class="container profile-page"><div class="page-intro"><div class="eyebrow muted-eyebrow">YOUR PROFESSIONAL IDENTITY</div><h1>Your skills, <span>your profile.</span></h1><p>Help customers understand what you do and how you can help.</p></div><div class="profile-layout"><aside class="profile-summary"><div class="profile-avatar"><%= profileUser.name.charAt(0).toUpperCase() %></div><h2><%= profileUser.name %></h2><span class="role-badge provider-role">Service provider</span><p><%= profileUser.profession || "Add your profession" %></p><a class="text-link" href="/provider-dashboard">Open dashboard →</a></aside><form class="content-card profile-form" action="/profile" method="POST"><h2>Professional information</h2><p class="muted-text">A complete profile helps customers find the right professional.</p><label class="form-label">Full name<input class="form-control" name="name" value="<%= profileUser.name %>" required maxlength="80"></label><label class="form-label">Email address<input class="form-control" value="<%= profileUser.email %>" disabled></label><div class="form-grid"><label class="form-label">Phone number<input class="form-control" name="phone" value="<%= profileUser.phone %>" placeholder="Contact number"></label><label class="form-label">City<input class="form-control" name="city" value="<%= profileUser.city %>" placeholder="City or area"></label></div><label class="form-label">Your main service<input class="form-control" name="profession" value="<%= profileUser.profession %>" placeholder="e.g. Electrician" required></label><label class="form-label">Skills <span class="optional">(comma-separated)</span><input class="form-control" name="skills" value="<%= (profileUser.skills || []).join(', ') %>" placeholder="Wiring, repairs, installation"></label><label class="form-label">Hourly rate (₹)<input class="form-control" type="number" min="0" name="hourlyRate" value="<%= profileUser.hourlyRate %>" placeholder="0 if you quote per job"></label><label class="form-label">About your work<textarea class="form-control" name="bio" rows="4" maxlength="600" placeholder="Describe your experience and the services you provide"><%= profileUser.bio %></textarea></label><label class="availability-toggle"><input type="checkbox" name="isAvailable" <%= profileUser.isAvailable ? "checked" : "" %>><span><strong>Available for bookings</strong><small>Show my profile in service search results</small></span></label><button class="btn btn-primary" type="submit">Save professional profile →</button></form></div></section>
<%- include("../partials/footer") %>
