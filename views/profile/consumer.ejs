<%- include("../partials/header", { pageTitle: "My profile" }) %>
<section class="container profile-page"><div class="page-intro"><div class="eyebrow muted-eyebrow">YOUR ACCOUNT</div><h1>My <span>profile.</span></h1><p>Keep your details up to date so service providers know how to reach you.</p></div><div class="profile-layout"><aside class="profile-summary"><div class="profile-avatar"><%= profileUser.name.charAt(0).toUpperCase() %></div><h2><%= profileUser.name %></h2><span class="role-badge">Consumer</span><p><%= profileUser.email %></p><a class="text-link" href="/consumer-dashboard">Open dashboard →</a></aside><form class="content-card profile-form" action="/profile" method="POST"><h2>Personal information</h2><p class="muted-text">Your details are kept with your account.</p><label class="form-label">Full name<input class="form-control" name="name" value="<%= profileUser.name %>" required maxlength="80"></label><label class="form-label">Email address<input class="form-control" value="<%= profileUser.email %>" disabled><small>Email cannot be changed here.</small></label><label class="form-label">Phone number<input class="form-control" name="phone" value="<%= profileUser.phone %>" placeholder="Your contact number"></label><label class="form-label">City<input class="form-control" name="city" value="<%= profileUser.city %>" placeholder="Your city"></label><button class="btn btn-primary" type="submit">Save changes →</button></form></div></section>
<%- include("../partials/footer") %>
