<%- include("partials/header", { pageTitle: "Find service professionals" }) %>
<section class="page-banner"><div class="container"><div class="eyebrow muted-eyebrow">THE PEOPLE BEHIND GREAT WORK</div><h1>Find your <span>right-fit professional.</span></h1><p>Search local skills and connect with people ready to help.</p></div></section>
<section class="container listing-section"><form class="filter-bar" action="/providers" method="GET"><label class="filter-input"><span>⌕</span><input name="q" value="<%= filters.q %>" placeholder="Service, skill or name"></label><label class="filter-input"><span>⌖</span><input name="city" value="<%= filters.city %>" placeholder="City or area"></label><label class="filter-input"><span>✦</span><input name="profession" value="<%= filters.profession %>" placeholder="Profession"></label><button class="btn btn-primary" type="submit">Search <span>→</span></button></form>
<div class="listing-heading"><h2>Available professionals</h2><span><%= providers.length %> result<%= providers.length === 1 ? "" : "s" %></span></div>
<% if (providers.length) { %><div class="provider-grid">
<% providers.forEach((p, i) => { %><article class="provider-card"><div class="provider-card-top"><div class="provider-avatar avatar-<%= i % 5 %>"><%= p.name.charAt(0).toUpperCase() %></div><span class="available-pill"><i></i> Available</span></div><h3><%= p.name %></h3><p class="provider-profession"><%= p.profession || "Service professional" %></p><p class="provider-location">⌖ <%= p.city || "Location not added" %></p><% if (p.bio) { %><p class="provider-bio"><%= p.bio %></p><% } %><div class="skill-list"><% (p.skills || []).slice(0,3).forEach(s => { %><span><%= s %></span><% }) %></div><div class="provider-card-bottom"><span><strong><%= p.hourlyRate ? "₹" + p.hourlyRate : "Rate on request" %></strong><% if (p.hourlyRate) { %><small>/ hour</small><% } %></span><a class="btn btn-outline btn-small" href="/providers/<%= p._id %>">View profile ↗</a></div></article><% }) %></div>
<% } else { %><div class="empty-state"><div class="empty-icon">⌕</div><h3>No matching professionals yet</h3><p>Try another keyword or city. Providers can create a profile to appear in these results.</p><a class="btn btn-primary" href="/register">Become a provider ↗</a></div><% } %></section>
<%- include("partials/footer") %>
