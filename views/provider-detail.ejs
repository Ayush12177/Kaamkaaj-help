<%- include("partials/header", { pageTitle: provider.name + " — Professional profile" }) %>
<section class="container detail-page"><a class="back-link" href="/providers">← Back to professionals</a><div class="detail-grid"><div class="detail-main"><div class="detail-profile-card"><div class="detail-avatar"><%= provider.name.charAt(0).toUpperCase() %></div><div><span class="available-pill"><i></i> <%= provider.isAvailable ? "Available for work" : "Currently unavailable" %></span><h1><%= provider.name %></h1><p class="provider-profession"><%= provider.profession || "Service professional" %></p><p class="provider-location">⌖ <%= provider.city || "Location not added" %></p></div></div><div class="content-card"><h2>About this professional</h2><p class="detail-bio"><%= provider.bio || "This professional has not added a bio yet. You can send a booking request to discuss your needs." %></p><h3>Skills & services</h3><div class="skill-list detail-skills"><% if (provider.skills.length) { provider.skills.forEach(s => { %><span><%= s %></span><% }) } else { %><span>General services</span><% } %></div></div><div class="content-card"><h2>What happens next?</h2><p class="muted-text">Send a booking request with your preferred date, time, and address. The provider can review it from their dashboard.</p></div></div>
<aside class="booking-card"><div class="form-kicker">BOOK A SERVICE</div><h2>Let's get it done.</h2><div class="rate-box"><span>Starting rate</span><strong><%= provider.hourlyRate ? "₹" + provider.hourlyRate : "Ask for rate" %><small><%= provider.hourlyRate ? "/ hour" : "" %></small></strong></div>
<% if (provider.isAvailable) { %><% if (currentUser && currentUser.role === "consumer") { %><form action="/bookings" method="POST" class="booking-form"><input type="hidden" name="providerId" value="<%= provider._id %>"><label class="form-label">Preferred date<input class="form-control" type="date" name="serviceDate" min="<%= new Date().toISOString().slice(0,10) %>" required></label><label class="form-label">Preferred time<input class="form-control" type="time" name="serviceTime" required></label><label class="form-label">Service address<textarea class="form-control" name="address" rows="2" placeholder="Where should the service happen?" required maxlength="300"></textarea></label><label class="form-label">Notes <span class="optional">(optional)</span><textarea class="form-control" name="notes" rows="3" placeholder="Tell them what you need..." maxlength="1000"></textarea></label><button class="btn btn-primary btn-block" type="submit">Request booking <span>→</span></button></form><% } else if (!currentUser) { %><p class="muted-text">Log in as a consumer to request a booking.</p><a class="btn btn-primary btn-block" href="/login">Log in to book ↗</a><% } else { %><p class="muted-text">Your service-provider account can't book another provider. Use a consumer account to make a booking.</p><% } %><% } else { %><p class="muted-text">This professional is not accepting bookings right now.</p><% } %></aside></div></section>
<%- include("partials/footer") %>
